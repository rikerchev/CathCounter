# --- core (must be set here — everything below this can also be set later
#     from Admin → Настройка на интеграциите in the app, without a restart) ---
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
# Only needed if this API's public URL can't be reliably auto-detected from
# the incoming request (e.g. behind certain proxies). Leave empty otherwise.
PUBLIC_API_URL=
# Any long random string. Rotate this and every issued token is invalidated.
JWT_SECRET=change-me-to-a-long-random-string

# --- database (local PostgreSQL, Neon, Supabase, RDS — all work) ---
# Local:    postgres://postgres:yourpassword@localhost:5432/catchcount
# Supabase: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@host:5432/catchcount

# --- Google OAuth (social login, optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- email (plain SMTP — no paid email API required) ---
# Any SMTP server works: your own mail server, a free-tier transactional
# sender (e.g. Brevo, SMTP2GO), or Gmail SMTP for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CatchCount <noreply@yourdomain.com>

# --- LLM (optional — leave as "none" to use the stub) ---
LLM_PROVIDER=none
LLM_API_KEY=

# Note: catch photos are stored directly in Postgres (see
# server/schema/schema.sql -> catch_photos), compressed client-side to
# ~400-500KB first, so no S3/R2/B2 object storage account is needed.
