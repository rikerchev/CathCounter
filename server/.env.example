# --- core (must be set here — everything below this can also be set later
#     from Admin → Настройка на интеграциите in the app, without a restart) ---
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
# Any long random string. Rotate this and every issued token is invalidated.
JWT_SECRET=change-me-to-a-long-random-string

# --- database (local PostgreSQL, Neon, Supabase, RDS — all work) ---
# Local:   postgres://postgres:yourpassword@localhost:5432/catchcount
# Managed: postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/catchcount

# --- Google OAuth (social login) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- object storage for photos (generic S3-compatible) ---
# Leave S3_ENDPOINT empty to use real AWS S3. Set it for R2 / Backblaze B2 /
# MinIO / any other S3-compatible provider, e.g.:
#   Cloudflare R2:  https://<account_id>.r2.cloudflarestorage.com
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=catchcount-uploads
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# If your bucket is served through a public domain/CDN, set it here so
# uploaded photo_urls point straight at it instead of a signed URL.
S3_PUBLIC_BASE_URL=

# --- email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=CatchCount <noreply@yourdomain.com>

# --- LLM (optional — leave as "none" to use the stub) ---
LLM_PROVIDER=none
LLM_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
