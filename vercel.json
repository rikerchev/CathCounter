{
  "routes": [
    { "src": "^/api/.*$", "dest": "/api/[...path].ts" },
    { "src": "^/(ribolovno-prilozhenie|riboloven-dnevnik|statistika-na-ulovite|ribolov-bez-internet|vodoemi-i-sastezaniya|kak-da-instalirate)/?$", "dest": "/$1.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/keep-alive", "schedule": "0 3 * * *" },
    { "path": "/api/cron/ad-renewals", "schedule": "0 6 * * *" }
  ]
}
