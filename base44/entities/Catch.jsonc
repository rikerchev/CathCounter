      "title": "Rod Model"
    },
    "bait": {
      "type": "string",
      "title": "Bait"
    },
    "hook_size": {
      "type": "string",
      "title": "Hook Size"
    },
    "line": {
      "type": "string",
      "title": "Line"
    },
    "feeder": {
      "type": "string",
      "title": "Feeder"
    },
    "rig_details": {
      "type": "string",
      "title": "Rig Details"
    },
    "distance": {
      "type": "string",
      "title": "Cast Distance"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "duration": {
      "type": "integer",
      "default": "0",
