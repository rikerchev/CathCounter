{
  "name": "SectorAvailability",
  "type": "object",
  "properties": {
    "water_body_id": {
      "type": "string",
      "title": "Водоем"
    },
    "water_body_name": {
      "type": "string",
      "title": "Име на водоема"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Начална дата"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "Крайна дата"
    },
    "total_sectors": {
      "type": "integer",
      "default": "10",
      "title": "Брой сектори"
    },
    "fee_per_person": {
      "type": "number",
      "default": "0",
      "title": "Такса на човек (€)"
    },
    "status": {
      "type": "enum",
      "default": "open",
      "enum": [
        "open",
        "closed"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "water_body_id",
    "date",
    "total_sectors"
  ],
  "rls": "read: public; create: water_owner or admin; update: owner or admin; delete: owner or admin"
}