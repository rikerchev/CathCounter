{
  "name": "MenuGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Име на групата"
    },
    "description": {
      "type": "string",
      "title": "Описание"
    },
    "menu_items": {
      "type": "string",
      "title": "Достъпни менюта (comma-separated paths)"
    },
    "status": {
      "type": "enum",
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "name",
    "menu_items"
  ],
  "rls": "read: public; create/update/delete: admin only"
}