{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "client_reference_id": {
      "type": "string",
      "title": "Client Reference ID"
    },
    "stripe_customer_id": {
      "type": "string",
      "title": "Stripe Customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "title": "Stripe Subscription ID"
    },
    "status": {
      "type": "enum",
      "default": "incomplete",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "incomplete"
      ],
      "title": "Status"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "title": "Current Period End"
    }
  },
  "required": [
    "client_reference_id"
  ],
  "rls": "read: client_reference_id={{user.id}} or admin; create/update/delete: admin only"
}