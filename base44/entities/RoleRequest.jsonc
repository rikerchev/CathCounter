{
  "name": "RoleRequest",
  "type": "object",
  "properties": {
    "requested_role": {
      "type": "enum",
      "enum": [
        "water_owner",
        "advertiser",
        "admin"
      ],
      "title": "Заявена роля"
    },
    "user_email": {
      "type": "string",
      "title": "Имейл на потребителя"
    },
    "user_name": {
      "type": "string",
      "title": "Име на потребителя"
    },
    "reason": {
      "type": "string",
      "title": "Основание"
    },
    "status": {
      "type": "enum",
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "requested_role",
    "user_email"
  ],
  "rls": "read: owner or admin; create: created_by_id={{user.id}}; update: admin only; delete: admin only"
}