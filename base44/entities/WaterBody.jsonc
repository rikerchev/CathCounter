{
  "name": "WaterBody",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Име на водоема"
    },
    "owner_name": {
      "type": "string",
      "title": "Име на собственика"
    },
    "contact_phone": {
      "type": "string",
      "title": "Телефон за връзка"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "title": "Имейл за връзка"
    },
    "location": {
      "type": "string",
      "title": "Локация / адрес"
    },
    "country": {
      "type": "string",
      "title": "Държава (ISO код)"
    },
    "region": {
      "type": "string",
      "title": "Регион / област"
    },
    "latitude": {
      "type": "number",
      "title": "Географска ширина"
    },
    "longitude": {
      "type": "number",
      "title": "Географска дължина"
    },
    "usage_conditions": {
      "type": "string",
      "title": "Условия за ползване"
    },
    "fish_population": {
      "type": "string",
      "title": "Популация на риби"
    },
    "max_depth": {
      "type": "number",
      "title": "Максимална дълбочина (м)"
    },
    "capacity": {
      "type": "string",
      "title": "Капацитет"
    },
    "fee_per_person": {
      "type": "number",
      "default": "0",
      "title": "Такса на човек (€)"
    },
    "iban": {
      "type": "string",
      "title": "Фирмен IBAN"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "title": "Лого URL"
    },
    "status": {
      "type": "enum",
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "name",
    "contact_phone",
    "location",
    "usage_conditions",
    "fish_population"
  ],
  "rls": "read: public; create: created_by_id={{user.id}}; update: owner or admin; delete: owner or admin"
}