{
  "name": "UserInventory",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "title": "Име на артикула"
    },
    "category": {
      "type": "enum",
      "default": "bait",
      "enum": [
        "groundbait",
        "bait",
        "rod",
        "hook",
        "line",
        "feeder",
        "other"
      ],
      "title": "Категория"
    },
    "brand": {
      "type": "string",
      "title": "Бранд"
    },
    "quantity": {
      "type": "number",
      "default": "0",
      "title": "Количество"
    },
    "unit": {
      "type": "enum",
      "default": "g",
      "enum": [
        "g",
        "kg",
        "pcs",
        "ml",
        "l"
      ],
      "title": "Мерна единица"
    },
    "description": {
      "type": "string",
      "title": "Описание"
    },
    "shop_url": {
      "type": "string",
      "format": "uri",
      "title": "Линк към търговеца"
    }
  },
  "required": [
    "item_name",
    "category"
  ],
  "rls": "read/create/update/delete: created_by_id={{user.id}}"
}