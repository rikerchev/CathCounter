{
  "name": "CompetitionRegistration",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string",
      "title": "Състезание"
    },
    "participant_name": {
      "type": "string",
      "title": "Име на участника"
    },
    "participant_phone": {
      "type": "string",
      "title": "Телефон на участника"
    },
    "slot_type": {
      "type": "enum",
      "default": "main",
      "enum": [
        "main",
        "reserve"
      ],
      "title": "Тип място"
    },
    "payment_status": {
      "type": "enum",
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "transferred"
      ],
      "title": "Статус на плащане"
    },
    "status": {
      "type": "enum",
      "default": "active",
      "enum": [
        "active",
        "cancelled"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "competition_id",
    "participant_name"
  ],
  "rls": "read: public; create: created_by_id={{user.id}}; update: owner; delete: owner"
}