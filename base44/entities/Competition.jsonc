{
  "name": "Competition",
  "type": "object",
  "properties": {
    "water_body_id": {
      "type": "string",
      "title": "Водоем"
    },
    "water_body_name": {
      "type": "string",
      "title": "Име на водоема"
    },
    "title": {
      "type": "string",
      "title": "Заглавие на състезанието"
    },
    "fishing_type": {
      "type": "enum",
      "default": "feeder",
      "enum": [
        "feeder",
        "float",
        "carp",
        "predator",
        "match",
        "other"
      ],
      "title": "Вид риболов"
    },
    "max_participants": {
      "type": "integer",
      "default": "20",
      "title": "Максимален брой участници"
    },
    "max_reserves": {
      "type": "integer",
      "default": "5",
      "title": "Максимален брой резерви"
    },
    "conditions": {
      "type": "string",
      "title": "Условия за участие"
    },
    "prize_fund": {
      "type": "string",
      "title": "Награден фонд"
    },
    "fee": {
      "type": "number",
      "default": "0",
      "title": "Такса за участие (€)"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "title": "Дата и час"
    },
    "registration_deadline": {
      "type": "string",
      "format": "date-time",
      "title": "Краен срок за записване"
    },
    "status": {
      "type": "enum",
      "default": "open",
      "enum": [
        "open",
        "closed",
        "completed",
        "cancelled"
      ],
      "title": "Статус"
    }
  },
  "required": [
    "water_body_id",
    "title",
    "fishing_type",
    "max_participants",
    "date"
  ],
  "rls": "read: public; create: water_owner or admin; update: owner or admin; delete: owner or admin"
}