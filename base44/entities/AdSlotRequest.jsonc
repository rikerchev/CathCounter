{
  "name": "AdSlotRequest",
  "type": "object",
  "properties": {
    "ad_slot_id": {
      "type": "string",
      "title": "Банер слот"
    },
    "ad_slot_name": {
      "type": "string",
      "title": "Име на банера"
    },
    "placement": {
      "type": "string",
      "title": "Позиция"
    },
    "advertiser_email": {
      "type": "string",
      "format": "email",
      "title": "Имейл на рекламодателя"
    },
    "advertiser_name": {
      "type": "string",
      "title": "Име на рекламодателя"
    },
    "ad_title": {
      "type": "string",
      "title": "Заглавие на рекламата"
    },
    "ad_description": {
      "type": "string",
      "title": "Описание на рекламата"
    },
    "ad_cta": {
      "type": "string",
      "title": "Бутон (CTA)"
    },
    "website_url": {
      "type": "string",
      "title": "Сайт (URL)"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "title": "Лого URL"
    },
    "ad_logo_size": {
      "type": "enum",
      "default": "auto",
      "enum": [
        "16x16",
        "32x16",
        "48x16",
        "auto"
      ],
      "title": "Размер на логото"
    },
    "ad_bg_class": {
      "type": "string",
      "default": "bg-gradient-to-r from-cyan-600 to-blue-600",
      "title": "Цвят на фона"
    },
    "ad_text_class": {
      "type": "string",
      "default": "text-white",
      "title": "Цвят на текста"
    },
    "months": {
      "type": "integer",
      "default": "1",
      "title": "Период (месеци)"
    },
    "additional_info": {
      "type": "string",
      "title": "Допълнителна информация"
    },
    "price_per_month": {
      "type": "number",
      "title": "Цена на месец (€)"
    },
    "total_price": {
      "type": "number",
      "title": "Обща цена (€)"
    },
    "countries": {
      "type": "string",
      "title": "Държави"
    },
    "country_pricing": {
      "type": "string",
      "title": "Цена по държави (JSON)"
    },
    "country_content": {
      "type": "string",
      "title": "Заглавие/описание по държави (JSON)"
    },
    "status": {
      "type": "enum",
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "paid",
        "cancelled"
      ],
      "title": "Статус"
    },
    "checkout_url": {
      "type": "string",
      "title": "Линк за плащане"
    }
  },
  "required": [
    "ad_slot_id",
    "advertiser_email",
    "website_url",
    "months"
  ],
  "rls": "read: owner or admin; create: created_by_id={{user.id}}; update: owner or admin; delete: admin only"
}