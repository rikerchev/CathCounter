{
  "name": "AppLanguage",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Language Code (e.g. en, bg, de)"
    },
    "name": {
      "type": "string",
      "title": "Language Name (English)"
    },
    "native_name": {
      "type": "string",
      "title": "Native Name"
    },
    "is_active": {
      "type": "boolean",
      "default": "true",
      "title": "Active"
    },
    "sort_order": {
      "type": "integer",
      "default": "0",
      "title": "Sort Order"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": "read: public; create/update/delete: admin only"
}