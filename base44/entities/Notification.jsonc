{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Target User ID"
    },
    "type": {
      "type": "enum",
      "default": "info",
      "enum": [
        "competition",
        "system",
        "info"
      ],
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "read": {
      "type": "boolean",
      "default": "false",
      "title": "Read"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": "read: user_id={{user.id}}; create: admin only; update: user_id={{user.id}}; delete: user_id={{user.id}}"
}